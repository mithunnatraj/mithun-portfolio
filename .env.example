# Supabase Configuration
# Obtain these from project settings -> API in your Supabase dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Resend Configuration
# Obtain this from API Keys in your Resend dashboard (starts with re_)
RESEND_API_KEY=re_your_api_key_here

# Notification Settings
# The personal email address where you want to receive contact notifications
PERSONAL_EMAIL=your-personal-email@example.com

# Cloudflare Turnstile Configuration
# Obtain these from Turnstile in your Cloudflare dashboard
VITE_TURNSTILE_SITEKEY=your-cloudflare-turnstile-sitekey-here
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secretkey-here
