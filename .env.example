# Supabase Configuration
# Obtain these from project settings -> API in your Supabase dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Resend Configuration
# Obtain this from API Keys in your Resend dashboard (starts with re_)
RESEND_API_KEY=re_your_api_key_here

# Notification Settings
# The personal email address where you want to receive contact notifications
PERSONAL_EMAIL=your-personal-email@example.com
